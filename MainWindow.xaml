<Window x:Class="saper1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sapper" Height="745" Width="755" ResizeMode="NoResize" WindowStyle="None"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextForeground}" BorderBrush="Transparent"
        AllowsTransparency="True" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#FF2D2D30"/>

        <Storyboard x:Key="RevealCellAnimation" Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                             From="0.8" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                             From="0.8" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="OpenSettingsAnimation" Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Overlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="CloseSettingsAnimation" Timeline.DesiredFrameRate="60">
            <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="-305" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Overlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="MainContainer">
        <Border x:Name="Main" Background="{DynamicResource PlayfieldBackground}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="5">
            <Grid>
                <Grid Height="65" VerticalAlignment="Top" Background="Transparent" MouseDown="ExitPanel_MouseDown">
                    <Button x:Name="settingsButton" Style="{DynamicResource RoundButton}" Content="⚙" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="23" Click="OpenSettingsButton_Click"/>
                    <TextBlock x:Name="Time" HorizontalAlignment="Center" VerticalAlignment="Center" Height="26" Width="84" FontSize="18" TextAlignment="Center" Text="00:00"/>
                    <Button x:Name="refreshButton" Style="{DynamicResource RoundButton}" Content="🗘" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,75,0" Click="RefreshButton_Click"/>
                    <Button x:Name="exit_btn" Style="{DynamicResource RoundButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Background="#00000000" Click="ExitButton_Click"/>
                </Grid>

                <Grid x:Name="playField" Height="650" Width="650" Margin="0,65,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowGridLines="False">
                    <Grid.Resources>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="32.5"/>
                        </Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="32.5"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                </Grid>

                <Border x:Name="Overlay" Background="#80000000" Opacity="0" Visibility="Collapsed"/>

                <Border x:Name="SettingsPanel"
                        HorizontalAlignment="Left"
                        Width="300"
                        Background="{DynamicResource PlayfieldBackground}"
                        CornerRadius="0,10,10,0"
                        RenderTransformOrigin="0.5,0.5"
                        CacheMode="BitmapCache">
                    <Border.RenderTransform>
                        <TranslateTransform X="-305"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Button x:Name="closeSettingsButton"
                                Content="✕"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Style="{DynamicResource RoundButton}"
                                FontSize="23"
                                Click="CloseSettingsButton_Click"
                                Margin="15,15,0,0"/>

                        <StackPanel Margin="15,80,15,15">
                            <TextBlock Text="Налаштування" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>
                            <TextBlock Text="Складність:" Margin="0,10"/>
                            <ComboBox SelectedIndex="0" x:Name="difficultyComboBox">
                                <ComboBoxItem>Новачок</ComboBoxItem>
                                <ComboBoxItem>Любитель</ComboBoxItem>
                                <ComboBoxItem>Професіонал</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="Тема:" Margin="0,20,0,10"/>
                            <ComboBox SelectedIndex="0" x:Name="themeComboBox">
                                <ComboBoxItem>Темна</ComboBoxItem>
                                <ComboBoxItem>Світла</ComboBoxItem>
                            </ComboBox>

                            <Button x:Name="confirmButton"
                                    Content="Підтвердити"
                                    Style="{DynamicResource ConfirmButton}"
                                    Margin="0,40,0,0"
                                    Click="ConfirmSettingsButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>